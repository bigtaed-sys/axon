<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 15 и новее.

  Там режим «во весь экран» включён принудительно, и одного fitsSystemWindows
  мало: система игнорирует его, пока приложение явно не откажется. Отказ —
  ровно этот флаг. Он временный по замыслу самой системы, поэтому когда-нибудь
  придётся считать отступы по-настоящему: забирать их у окна нативно и отдавать
  в CSS переменной.
-->
<resources>
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:statusBarColor">@color/axonSystemBars</item>
        <item name="android:navigationBarColor">@color/axonSystemBars</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
