<?xml version="1.0" encoding="utf-8"?>
<!--
  Разрешение на обычный http.

  Начиная с Android 9 система запрещает приложениям незашифрованные запросы,
  и запрещает молча: запрос не уходит вовсе, а приложение видит только «не
  удалось достучаться». Первое подключение к своему ядру упиралось ровно в это.

  Ядру TLS не положен намеренно: сертификат внутри демона дал бы иллюзию
  защиты, а настоящий слой шифрования — туннель или обратный прокси. Адрес
  человек вводит сам и знает, куда идёт. Ограничить список адресов заранее
  нельзя: своё ядро у каждого по своему адресу, и в этом весь смысл.

  Для доступа через интернет пользуйтесь https-адресом туннеля — тогда ничего
  из этого не задействуется.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
