<?xml version="1.0" encoding="utf-8"?>
<!--
  Цвет системных полос.

  Ровно фон страницы в тёмной теме (c-bg из globals.css, 10 10 12), а не
  поверхность: любое отличие превращается в шов под часами, и затемнение под
  шапкой упирается в чужой оттенок вместо того, чтобы уйти в тот же чёрный.

  Цвет один на все темы. Чтобы полосы следовали за светлой темой, их пришлось
  бы красить из приложения нативным плагином; пока тёмная стоит по умолчанию,
  это лишняя зависимость ради редкого случая.
-->
<resources>
    <color name="axonSystemBars">#0A0A0C</color>
</resources>
