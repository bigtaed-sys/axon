<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
        Содержимое не заезжает под системные полосы.

        С targetSdk 35 Android рисует приложение во весь экран по умолчанию, а
        WebView про эти отступы ничего не знает: env(safe-area-inset-*) в нём
        остаётся нулём. Из-за этого шапка приложения оказывалась под часами и
        значками, а первое сообщение обрезалось строкой состояния.

        Полосы красим в цвет поверхности приложения: светлая полоса над тёмным
        окном выглядит чужой заплаткой.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:statusBarColor">@color/axonSystemBars</item>
        <item name="android:navigationBarColor">@color/axonSystemBars</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>