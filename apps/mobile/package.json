{
  "name": "@axon/mobile",
  "version": "0.1.0",
  "private": true,
  "comment:version": "Заглушка. Настоящий номер приходит из git-тега через define в vite.config.ts — как и у десктопа.",
  "description": "Axon для Android: то же окно, только к ядру подключаются по адресу и коду",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
