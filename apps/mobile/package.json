    "apk": "npm run sync && node build/apk.mjs",
    "android": "npm run sync && cap open android"
  },
  "dependencies": {
    "@axon/client-sdk": "*",
    "@axon/protocol": "*",
    "@axon/ui": "*",
    "@capacitor/android": "^7.0.0",
