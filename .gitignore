# Сборка и зависимости
node_modules/
dist/
*.tsbuildinfo

# Готовые установщики и распакованное приложение: сотни мегабайт,
# восстанавливаются одной командой сборки.
apps/desktop/release/
apps/desktop/build/daemon/
apps/desktop/build/icon.png

# Секреты
.env
.env.local
*.key

# Наши рабочие записи. Лежат в репозитории на диске, но в историю не
# попадают: репозиторий публичный, а история публикуется навсегда — вынуть
# из неё что-то задним числом нельзя.
develop_docs/

# Мусор системы и редакторов
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/

# Оболочка Android лежит в репозитории — в ней иконки, разрешения и версия.
# Не попадает только то, что рождается сборкой.
apps/mobile/dist/
apps/mobile/android/build/
apps/mobile/android/app/build/
apps/mobile/android/capacitor-cordova-android-plugins/build/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/Axon-*.apk
# Ключ подписи приложения и пароль от него. Потерять их нельзя, а положить
# сюда — тем более: право выпускать приложение от нашего имени это и есть ключ.
apps/mobile/signing/
apps/mobile/android/app/src/main/assets/public/
