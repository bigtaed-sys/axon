#!/bin/sh
# Проверки перед отправкой: типы, тесты, клиент.
#
# Заменяет собой CI, которого у нас нет: GitHub Actions заблокированы на
# уровне аккаунта. Разница только в том, что забыть проверку теперь мешает
# собственная машина, а не чужая.
#
# Включается один раз:
#     git config core.hooksPath .githooks
#
# Пропустить, когда очень надо: git push --no-verify
npm run check

if [ $? -ne 0 ]; then
  echo ''
  echo 'Проверки не прошли — push отменён.'
  echo 'Если это осознанно: git push --no-verify'
  exit 1
fi
