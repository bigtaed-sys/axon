{
  "name": "axon",
  "version": "0.0.0",
  "private": true,
  "description": "Axon — персональный AI-агент: ядро на своей машине, клиенты подключаются к нему",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc --build && node packages/daemon/scripts/bundle.mjs",
    "typecheck": "tsc --build --force",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:npm": "node scripts/release-npm.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
